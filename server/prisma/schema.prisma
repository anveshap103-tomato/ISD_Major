// Prisma Schema for Ryth Core
// Problem Statement ID: 2501010153

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================
// Core Identity Models (Jatin)
// =============================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // One-to-one relation with CreatorProfile (Tushar)
  creatorProfile CreatorProfile?

  @@map("users")
}

// =============================================================
// Creator Discovery & Profile Models (Tushar Singh)
// =============================================================

model CreatorProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  professionalTitle String   @map("professional_title")
  organization      String?
  location          String?
  introduction      String?  @db.Text
  biography         String?  @db.Text
  profileImage      String?  @map("profile_image")
  socialLinks       Json?    @map("social_links")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relationships
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       CreatorSkill[]
  achievements CreatorAchievement[]

  // Indexes for performant search & lookups
  @@index([professionalTitle])
  @@index([location])
  @@map("creator_profiles")
}

model CreatorSkill {
  id               String   @id @default(uuid())
  creatorProfileId String   @map("creator_profile_id")
  skillName        String   @map("skill_name")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relationships
  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  // Prevent duplicate skills for the same creator & optimize skill search
  @@unique([creatorProfileId, skillName])
  @@index([creatorProfileId])
  @@index([skillName])
  @@map("creator_skills")
}

model CreatorAchievement {
  id                  String   @id @default(uuid())
  creatorProfileId    String   @map("creator_profile_id")
  title               String
  description         String?  @db.Text
  issuingOrganization String?  @map("issuing_organization")
  achievementType     String   @default("AWARD") @map("achievement_type")
  year                String?
  createdAt           DateTime @default(now()) @map("created_at")

  // Relationships
  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  // Indexes for creator lookups
  @@index([creatorProfileId])
  @@index([achievementType])
  @@map("creator_achievements")
}

