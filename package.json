{
  "name": "ryth-core-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Ryth Core - Connecting learning, creator discovery, and real-world networking",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client & npm run dev --workspace=server",
    "client:dev": "npm run dev --workspace=client",
    "server:dev": "npm run dev --workspace=server",
    "client:build": "npm run build --workspace=client",
    "server:build": "npm run build --workspace=server",
    "install:all": "npm install"
  },
  "keywords": [
    "ryth-core",
    "react",
    "express",
    "prisma",
    "postgresql",
    "capacitor"
  ],
  "author": "Ryth Core Team",
  "license": "ISC"
}

